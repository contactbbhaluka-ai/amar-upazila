# এই ফাইলটি কপি করে ".env" নামে সেভ করুন, তারপর মানগুলো বসান।
# Supabase Dashboard → Project Settings → API (বা "Connect") থেকে পাবেন।
# anon/publishable key অ্যাপের ভেতরে থাকে, এটা গোপন নয়। service_role key কখনো এখানে দেবেন না!
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
VITE_UPAZILA_ID=1
# শেয়ার করা পোস্টের লিংকে ওয়েব ভার্সনের ঠিকানা (না দিলে GitHub Pages-এর ঠিকানা ধরা হয়)
VITE_PUBLIC_URL=https://your-username.github.io/amar-upazila/
